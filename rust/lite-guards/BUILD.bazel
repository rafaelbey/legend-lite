load("@rules_rust//rust:defs.bzl", "rust_test")
load("//tools/guards:defs.bzl", "guards_package")

# THE RUST PORT'S GUARDS (tests/guards.rs; docs/rust-port/PHASE3_CRATES.md §3, 2026-11-11): the crate graph held to
# crate-layers.txt and that file to tools/deps/core-layers.txt, as //tools/deps:core_layering_test holds core's
# libraries; and the arena ruling's source rules (unsafe in lite-base's arena alone, addresses in its identity alone).

# Bazel's own answer for each crate's library: its direct dependencies (the test reads the crate from the file's name,
# deps_<crate>). A crate with a library and no query here fails the test.
_LIBRARIES = {
    "lite-base": "//rust/lite-base:lite_base",
    "lite-builtin": "//rust/lite-builtin:lite_builtin",
    "lite-dialect": "//rust/lite-dialect:lite_dialect",
    "lite-error": "//rust/lite-error:lite_error",
    "lite-ffi": "//rust/lite-ffi:lite_ffi",
    "lite-front": "//rust/lite-front:lite_front",
    "lite-javacompat": "//rust/lite-javacompat:lite_javacompat",
    "lite-json": "//rust/lite-json:lite_json",
    "lite-model": "//rust/lite-model:lite_model",
    "lite-names": "//rust/lite-names:lite_names",
    "lite-normalizer": "//rust/lite-normalizer:lite_normalizer",
    "lite-platform": "//rust/lite-platform:lite_platform",
    "lite-sql": "//rust/lite-sql:lite_sql",
    "lite-types": "//rust/lite-types:lite_types",
}

[genquery(
    name = "deps_" + crate,
    expression = "labels(deps, %s)" % library,
    scope = [library],
) for crate, library in _LIBRARIES.items()]

# every crate's sources and manifest (lite-front's since 2026-11-11, its exemption lifted: docs/rust-port/PHASE3.md
# step 1)
_SOURCES = [
    "//rust/lite-base:sources",
    "//rust/lite-builtin:sources",
    "//rust/lite-dialect:sources",
    "//rust/lite-error:sources",
    "//rust/lite-ffi:sources",
    "//rust/lite-front:sources",
    "//rust/lite-javacompat:sources",
    "//rust/lite-json:sources",
    "//rust/lite-model:sources",
    "//rust/lite-names:sources",
    "//rust/lite-normalizer:sources",
    "//rust/lite-platform:sources",
    "//rust/lite-sql:sources",
    "//rust/lite-types:sources",
]

_OWN = [
    "Cargo.toml",
    "crate-layers.txt",
    "src/lib.rs",
    "tests/guards.rs",
]

rust_test(
    name = "guards_test",
    srcs = ["tests/guards.rs"],
    data = _OWN + _SOURCES + ["//tools/deps:core-layers.txt"] + [":deps_" + c for c in _LIBRARIES],
    edition = "2024",
    env = {
        "LITE_CRATE_DEPS": " ".join(["$(rootpath :deps_%s)" % c for c in _LIBRARIES]),
        "LITE_GUARD_FILES": " ".join(
            ["$(rootpath %s)" % f for f in _OWN + ["//tools/deps:core-layers.txt"]] +
            ["$(rootpaths %s)" % s for s in _SOURCES],
        ),
    },
    visibility = ["//gates:__pkg__"],
)

guards_package()
