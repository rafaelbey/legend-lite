load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/guards:defs.bzl", "guards_package")

# The protocol records in Rust, generated from the Java records (//core:front_records_rs, FrontCodegen): regenerate with
# `bazel run //rust/lite-front:update_generated`; its diff test (in //:generated) fails when the records move.
write_source_files(
    name = "update_generated",
    testonly = True,
    diff_test_failure_message = "{{DEFAULT_MESSAGE}}\nThe protocol records moved -- regenerate: bazel run //rust/lite-front:update_generated",
    files = {"src/records.rs": "//core:front_records_rs"},
    visibility = ["//:__pkg__"],
)

# legend-lite's front end, ported from core/'s com.legend.lexer and com.legend.parser (src/lib.rs;
# docs/rust-port/PHASE2.md): over a text's UTF-16 units as Java indexes a String. Step 2: the lexer; step 3: the
# expression parser.
rust_library(
    name = "lite_front",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//rust:__subpackages__"],
    deps = ["//rust/lite-javacompat:lite_javacompat"],
)

rust_test(
    name = "lite_front_test",
    crate = ":lite_front",
    edition = "2024",
    visibility = ["//gates:__pkg__"],
)

# Every text of the front oracle (//rust/oracles:front_questions) lexed by Rust and held to the Java lexer's token
# stream for it (the canonical form's SHA-256, frozen: //rust/oracles:front_tokens, rust/oracles/front/MANIFEST.tsv;
# //core:front_tokens until 2026-11-06, step 6a): all of them identical.
rust_test(
    name = "front_lexer_differential_test",
    size = "medium",
    srcs = [
        "tests/front_lexer_differential.rs",
        "tests/support/deliberate.rs",
    ],
    args = ["--ignored"],
    crate_root = "tests/front_lexer_differential.rs",
    data = [
        "//rust/oracles:front/deliberate-differences.tsv",
        "//rust/oracles:front_questions",
        "//rust/oracles:front_tokens",
    ],
    edition = "2024",
    env = {
        "LITE_FRONT_DELIBERATE": "$(rootpath //rust/oracles:front/deliberate-differences.tsv)",
        "LITE_FRONT_QUESTIONS": "$(rootpath //rust/oracles:front_questions)",
        "LITE_FRONT_TOKENS": "$(rootpath //rust/oracles:front_tokens)",
    },
    visibility = ["//gates:__pkg__"],
    deps = [":lite_front"],
)

# Every question of the front oracle whose door Rust answers, held to the Java parser's answer for it (the canonical
# form's SHA-256, frozen: //rust/oracles:front_answers, rust/oracles/front/MANIFEST.tsv; //core:front_answers until
# 2026-11-06, step 6a): at least each door's floor (tests/<door>-floor.txt) identical.
# Large (2026-11-05, phase 2 step 4a): the model door parses its 87,564 questions' texts and hashes their answers, about
# 170 s unoptimized on an idle machine (fastbuild is rustc's opt-level 0; 40 s of it optimized), past medium's 300 s
# once the remaining section grammars parse too. Since 2026-11-06 every build optimizes the crates (MODULE.bazel's
# rust.toolchain opt_level): 34 s with every grammar, still large so a slow runner has room.
rust_test(
    name = "front_parser_differential_test",
    size = "large",
    srcs = [
        "tests/front_parser_differential.rs",
        "tests/support/deliberate.rs",
    ],
    args = ["--ignored"],
    crate_root = "tests/front_parser_differential.rs",
    data = [
        "//rust/oracles:front/deliberate-differences.tsv",
        "tests/block-floor.txt",
        "tests/lambda-floor.txt",
        "tests/pmcd-floor.txt",
        "tests/spec-floor.txt",
        "//rust/oracles:front_answers",
        "//rust/oracles:front_questions",
    ],
    edition = "2024",
    env = {
        "LITE_FRONT_ANSWERS": "$(rootpath //rust/oracles:front_answers)",
        "LITE_FRONT_DELIBERATE": "$(rootpath //rust/oracles:front/deliberate-differences.tsv)",
        "LITE_FRONT_FLOORS": " ".join([
            "$(rootpath tests/block-floor.txt)",
            "$(rootpath tests/lambda-floor.txt)",
            "$(rootpath tests/pmcd-floor.txt)",
            "$(rootpath tests/spec-floor.txt)",
        ]),
        "LITE_FRONT_QUESTIONS": "$(rootpath //rust/oracles:front_questions)",
    },
    visibility = ["//gates:__pkg__"],
    deps = [":lite_front"],
)

# The front oracle's questions at the two engine-JSON doors (phase 2, step 5): every model text at the engine's dialect
# (`document`, PmcdParser.parseDocument) and every lambda (`lambdaJson`, SpecParser.lambdaJson), answered by the Rust
# emitter in both forms -- with source information and without it -- and held to Java's parser and emitter (each
# form's SHA-256, frozen: //rust/oracles:front_engine, rust/oracles/front/MANIFEST.tsv; //core:front_engine_answers
# until 2026-11-06, step 6a): at least each door's floor (tests/<door>-floor.txt) identical.
# Medium (2026-11-06): 30,064 questions, about 8 s optimized.
rust_test(
    name = "front_engine_differential_test",
    size = "medium",
    srcs = [
        "tests/front_engine_differential.rs",
        "tests/support/deliberate.rs",
    ],
    args = ["--ignored"],
    crate_root = "tests/front_engine_differential.rs",
    data = [
        "//rust/oracles:front/deliberate-differences.tsv",
        "tests/document-floor.txt",
        "tests/lambdaJson-floor.txt",
        "//rust/oracles:front_engine",
        "//rust/oracles:front_questions",
    ],
    edition = "2024",
    env = {
        "LITE_FRONT_DELIBERATE": "$(rootpath //rust/oracles:front/deliberate-differences.tsv)",
        "LITE_FRONT_ENGINE": "$(rootpath //rust/oracles:front_engine)",
        "LITE_FRONT_FLOORS": " ".join([
            "$(rootpath tests/document-floor.txt)",
            "$(rootpath tests/lambdaJson-floor.txt)",
        ]),
        "LITE_FRONT_QUESTIONS": "$(rootpath //rust/oracles:front_questions)",
    },
    visibility = ["//gates:__pkg__"],
    deps = [":lite_front"],
)

# the crate's sources and manifest, for //rust/lite-guards' source and crate-graph guards (2026-11-11,
# docs/rust-port/PHASE3_CRATES.md §3; lite-front's exemption from them lifted that day, docs/rust-port/PHASE3.md step 1)
filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs", "tests/**/*.rs"]) + ["Cargo.toml"],
    visibility = ["//rust/lite-guards:__pkg__"],
)

guards_package()
