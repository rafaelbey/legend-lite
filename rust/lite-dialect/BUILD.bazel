load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/guards:defs.bzl", "guards_package")

# 2026-11-03: core's scan-order guard (TestLaneOrderGuardrailTest) reads where DuckDB's pass list installs StableScanOrder
exports_files(["src/passes.rs"])

# legend-lite's SQL dialects, ported from core/'s com.legend.sql.dialect (src/lib.rs; docs/rust-port/PHASE1.md steps 3
# and 4): the shared renderer (Java's AnsiSqlRenderer as a trait), the writer, the pass pipeline with every pass DuckDB
# and the H2 family run, the typing rules its constructors apply (Java's SqlTyping), DuckDB, H2 and H2Modern, and the
# engine-text dialects (EngineStyleH2, EngineStyleDB2, EngineStyleComposite), rendering a lite_sql statement as the JVM
# does. It embeds the JDK's time-zone rules (src/java_time.rs includes //rust/oracles/tzdb:tzdb.bin, 146 KB).
rust_library(
    name = "lite_dialect",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//rust/oracles/tzdb:tzdb.bin"],
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//rust:__subpackages__"],
    deps = [
        "//rust/lite-javacompat:lite_javacompat",
        "//rust/lite-json:lite_json",
        "//rust/lite-sql:lite_sql",
    ],
)

rust_test(
    name = "lite_dialect_test",
    crate = ":lite_dialect",
    edition = "2024",
    visibility = ["//gates:__pkg__"],
)

# every statement of the golden oracles (//rust/oracles:mir_dump, :h2_dump and the tagged engine-text query) of each
# dialect Rust answers -- DuckDb 16,154, H2 21,847, H2Modern 394, EngineStyleH2 2,105, EngineStyleDB2 56,
# EngineStyleComposite 24 -- rendered by a fresh Rust dialect and held to Java's answer, at least each dialect's floor
# (tests/<dialect>-floor.txt) identical; every type fact of every statement of the oracles recomputed and held to Java's;
# and every op of each dialect's statements answered through the seam (SEAM.md) exactly as a direct call answers it;
# and the engine text's zone shift held to java.time over the JDK's tzdb (//rust/oracles/tzdb: every region's offsets,
# gaps and overlaps, and Java's own EngineStyleH2 renders), the embedded tzdb.bin held to the generator's output on the
# build's JDK (a JDK bump that changes the rules fails until they are regenerated) (tests/dialect_differential.rs,
# PARITY.md; cargo runs it with --ignored, LITE_ORACLES, LITE_ZONE_ORACLES and LITE_TZDB_GENERATED)
rust_test(
    name = "dialect_differential_test",
    srcs = ["tests/dialect_differential.rs"],
    args = ["--ignored"],
    data = [
        "tests/duckdb-floor.txt",
        "tests/enginestylecomposite-floor.txt",
        "tests/enginestyledb2-floor.txt",
        "tests/enginestyleh2-floor.txt",
        "tests/h2-floor.txt",
        "tests/h2modern-floor.txt",
        "//rust/oracles:h2_dump",
        "//rust/oracles:mir/tagged-engine.jsonl",
        "//rust/oracles:mir_dump",
        "//rust/oracles/tzdb:engine-text-zones.tsv",
        "//rust/oracles/tzdb:out/tzdb.bin",
        "//rust/oracles/tzdb:zone_golden",
    ],
    edition = "2024",
    env = {
        "LITE_DIALECT_FLOORS": " ".join([
            "$(rootpath tests/duckdb-floor.txt)",
            "$(rootpath tests/h2-floor.txt)",
            "$(rootpath tests/h2modern-floor.txt)",
            "$(rootpath tests/enginestyleh2-floor.txt)",
            "$(rootpath tests/enginestyledb2-floor.txt)",
            "$(rootpath tests/enginestylecomposite-floor.txt)",
        ]),
        "LITE_ORACLES": " ".join([
            "$(rootpath //rust/oracles:mir_dump)",
            "$(rootpath //rust/oracles:h2_dump)",
            "$(rootpath //rust/oracles:mir/tagged-engine.jsonl)",
        ]),
        "LITE_TZDB_GENERATED": "$(rootpath //rust/oracles/tzdb:out/tzdb.bin)",
        "LITE_ZONE_ORACLES": " ".join([
            "$(rootpath //rust/oracles/tzdb:zone_golden)",
            "$(rootpath //rust/oracles/tzdb:engine-text-zones.tsv)",
        ]),
    },
    visibility = ["//gates:__pkg__"],
    deps = [
        ":lite_dialect",
        "//rust/lite-json:lite_json",
        "//rust/lite-sql:lite_sql",
    ],
)

guards_package()
