diff --git a/base/src/main/java/com/legend/base/SqlTap.java b/base/src/main/java/com/legend/base/SqlTap.java
new file mode 100644
--- /dev/null
+++ b/base/src/main/java/com/legend/base/SqlTap.java
@@ -0,0 +1,102 @@
+// Copyright 2026 Legend Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package com.legend.base;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.regex.Pattern;
+
+/**
+ * TEMPORARY (Rust port, phase 3 step 0 redone on the merged tree, the CONTROL run -- never committed to the sources;
+ * rust/tools/identity-control-tap.patch, docs/rust-port/PHASE3.md): every statement a JDBC session sends, in order, one
+ * line per statement (its length and a hash of its text), and every plan the two plan sites make (a product query's
+ * {@code TypedQuery.planned}, a test body's {@code TestPlanner.plan} and {@code planAhead}: {@code P:<kind>:<id>}, the id
+ * the identity probe gives the plan's JSON once its execution-trace UUID is masked), so that a run with the identity probe
+ * can be compared with a run of this class alone: counting must not alter what is computed. Written to the test's
+ * undeclared outputs, else java.io.tmpdir.
+ */
+public final class SqlTap {
+
+    private SqlTap() {
+    }
+
+    private static final String FILE = "identity-sql-" + ProcessHandle.current().pid() + ".txt";
+
+    /** The plan oracle's one mask (rust/oracles/plan/MANIFEST.tsv): the trace comment's UUID, minted per run. */
+    private static final Pattern TRACE = Pattern.compile(
+            "(?<k>executionTraceID\\\\?\"\\s*:\\s*\\\\?\")[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}");
+
+    public static String sent(String statement) {
+        write(statement.length() + ":" + id(statement) + "\n");
+        return statement;
+    }
+
+    public static <T> T plan(T executionPlan) {
+        planned('E', "com.legend.executionplan.PlanJson", "com.legend.executionplan.ExecutionPlan", executionPlan);
+        return executionPlan;
+    }
+
+    public static <T> T testPlan(T testPlan) {
+        planned('T', "com.legend.testexecutionplan.TestPlanJson", "com.legend.testexecutionplan.TestPlan", testPlan);
+        return testPlan;
+    }
+
+    public static <T> @Nullable T testPlanAhead(@Nullable T testPlan) {
+        if (testPlan == null) {
+            write("P:T:null\n");
+            return null;
+        }
+        return testPlan(testPlan);
+    }
+
+    private static void planned(char kind, String writer, String type, Object plan) {
+        String text;
+        try {
+            text = (String) Class.forName(writer).getMethod("write", Class.forName(type)).invoke(null, plan);
+        } catch (ReflectiveOperationException | LinkageError | RuntimeException | StackOverflowError e) {
+            write("P:" + kind + ":!" + e.getClass().getSimpleName() + "\n");
+            return;
+        }
+        String masked = TRACE.matcher(text).replaceAll("${k}00000000-0000-0000-0000-000000000000");
+        write("P:" + kind + ":" + sha16(masked) + "\n");
+    }
+
+    /** The identity probe's id: SHA-256 of the text's UTF-16 units, little-endian. */
+    private static String sha16(String text) {
+        byte[] b = new byte[text.length() * 2];
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            b[2 * i] = (byte) c;
+            b[2 * i + 1] = (byte) (c >> 8);
+        }
+        try {
+            return java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(b));
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static String id(String text) {
+        try {
+            return java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(text.getBytes(StandardCharsets.UTF_8)), 0, 12);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static synchronized void write(String line) {
+        try {
+            String d = System.getenv("TEST_UNDECLARED_OUTPUTS_DIR");
+            Path dir = Path.of(d != null ? d : System.getProperty("java.io.tmpdir"));
+            Files.writeString(dir.resolve(FILE), line, StandardCharsets.UTF_8, StandardOpenOption.CREATE,
+                    StandardOpenOption.APPEND);
+        } catch (IOException | RuntimeException e) {
+            // a probe that cannot write must not fail the test it rides on
+        }
+    }
+}
