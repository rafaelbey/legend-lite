diff --git a/core/src/main/java/com/legend/sql/dialect/MirDumpProbe.java b/core/src/main/java/com/legend/sql/dialect/MirDumpProbe.java
new file mode 100644
index 000000000..9a886b768
--- /dev/null
+++ b/core/src/main/java/com/legend/sql/dialect/MirDumpProbe.java
@@ -0,0 +1,143 @@
+// Copyright 2026 Legend Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package com.legend.sql.dialect;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * TEMPORARY (Rust port, phase 1 step 5a -- never committed; rust/tools/dialects-dump-probe.patch): every distinct
+ * input the ten Java dialects left (Postgres, SQLite, Snowflake, BigQuery, Databricks, Trino, ClickHouse, MariaDb,
+ * MySql, MongoDb) are asked to render or translate, dumped once per JVM with the answer of a FRESH dialect of the same
+ * class, in the line format of rust/oracles/mir/h2-dump.jsonl (config null: every one is made without arguments).
+ * Reflection, because sql/dialect may not depend on executionplan or json. Written to the test's undeclared outputs,
+ * else java.io.tmpdir (a java_run action's declared scratch directory).
+ */
+final class MirDumpProbe {
+
+    private MirDumpProbe() {
+    }
+
+    private static final Set<String> FAMILY = Set.of("Postgres", "SQLite", "Snowflake", "BigQuery", "Databricks",
+            "Trino", "ClickHouse", "MariaDb", "MySql", "MongoDb");
+    private static final ThreadLocal<Boolean> BUSY = ThreadLocal.withInitial(() -> Boolean.FALSE);
+    private static final Set<String> SEEN = ConcurrentHashMap.newKeySet();
+    private static final ConcurrentHashMap<String, AtomicLong> PER_KIND = new ConcurrentHashMap<>();
+    private static final long STATEMENT_CAP = 400;
+    private static final String TAG = String.valueOf(ProcessHandle.current().pid());
+
+    /** One input of {@code op}, dumped with a fresh dialect's answer. {@code input} is the Java value. */
+    static void dump(AnsiSqlRenderer dialect, String op, Object input) {
+        String name = dialect.getClass().getSimpleName();
+        if (!FAMILY.contains(name) || BUSY.get()) {
+            return;
+        }
+        BUSY.set(Boolean.TRUE);
+        try {
+            String mir = mirOf(input);
+            String kind = input instanceof String ? "String" : input.getClass().getSimpleName();
+            boolean statement = op.startsWith("ddl") || op.startsWith("dml");
+            AtomicLong perKind = PER_KIND.computeIfAbsent(name + "/" + kind, k -> new AtomicLong());
+            if (statement && perKind.get() >= STATEMENT_CAP) {
+                return;
+            }
+            if (!SEEN.add(name + '\u0000' + op + '\u0000' + mir)) {
+                return;
+            }
+            if (statement) {
+                perKind.incrementAndGet();
+            }
+            AnsiSqlRenderer fresh = dialect.getClass().getDeclaredConstructor().newInstance();
+            String out;
+            try {
+                out = "{\"ok\":" + answerOf(fresh, op, input) + "}";
+            } catch (RuntimeException e) {
+                out = "{\"throws\":" + quote(e.getClass().getName()) + ",\"message\":"
+                        + quote(String.valueOf(e.getMessage())) + "}";
+            }
+            append("{\"dialect\":" + quote(name) + ",\"config\":null,\"fresh\":true,\"op\":" + quote(op)
+                    + ",\"kind\":" + quote(kind) + ",\"mir\":" + mir + ",\"answer\":" + out + "}\n");
+        } catch (Throwable t) {
+            Throwable cause = t instanceof java.lang.reflect.InvocationTargetException i && i.getCause() != null
+                    ? i.getCause() : t;
+            append("{\"probeError\":" + quote(name + " " + op + ": " + cause) + ",\"input\":"
+                    + quote(String.valueOf(input)) + "}\n");
+        } finally {
+            BUSY.set(Boolean.FALSE);
+        }
+    }
+
+    private static String answerOf(AnsiSqlRenderer d, String op, Object input) {
+        return switch (op) {
+            case "query.render" -> quote(d.render((com.legend.sql.SqlQuery) input));
+            case "query.renderStatement" -> statement(d.renderStatement((com.legend.sql.SqlQuery) input));
+            case "ddl.render" -> quote(d.render((com.legend.sql.SqlDdl) input));
+            case "dml.render" -> quote(d.render((com.legend.sql.SqlDml) input));
+            case "dml.renderStatement" -> statement(d.renderStatement((com.legend.sql.SqlDml) input));
+            case "fromEngineText" -> quote(d.fromEngineText((String) input));
+            default -> throw new IllegalStateException(op);
+        };
+    }
+
+    private static String mirOf(Object input) throws ReflectiveOperationException {
+        if (input instanceof String s) {
+            return quote(s);
+        }
+        Class<?> mir = Class.forName("com.legend.executionplan.MirJson");
+        Class<?> json = Class.forName("com.legend.json.Json");
+        Object tree;
+        if (input instanceof com.legend.sql.SqlQuery q) {
+            tree = mir.getMethod("query", com.legend.sql.SqlQuery.class).invoke(null, q);
+        } else if (input instanceof com.legend.sql.SqlDdl d) {
+            tree = mir.getMethod("ddl", com.legend.sql.SqlDdl.class).invoke(null, d);
+        } else if (input instanceof com.legend.sql.SqlDml d) {
+            tree = mir.getMethod("dml", com.legend.sql.SqlDml.class).invoke(null, d);
+        } else {
+            throw new IllegalStateException("no MirJson for " + input.getClass());
+        }
+        return (String) json.getMethod("toCompact", Object.class).invoke(null, tree);
+    }
+
+    private static String statement(RenderedStatement s) {
+        return "{\"sql\":" + quote(s.sql()) + ",\"binds\":" + quote(String.valueOf(s.binds())) + ",\"regions\":"
+                + quote(String.valueOf(s.regions())) + "}";
+    }
+
+    static String quote(String s) {
+        StringBuilder b = new StringBuilder("\"");
+        for (char c : s.toCharArray()) {
+            switch (c) {
+                case '"' -> b.append("\\\"");
+                case '\\' -> b.append("\\\\");
+                case '\n' -> b.append("\\n");
+                case '\r' -> b.append("\\r");
+                case '\t' -> b.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        b.append(String.format(java.util.Locale.ROOT, "\\u%04x", (int) c));
+                    } else {
+                        b.append(c);
+                    }
+                }
+            }
+        }
+        return b.append('"').toString();
+    }
+
+    private static synchronized void append(String line) {
+        try {
+            String d = System.getenv("TEST_UNDECLARED_OUTPUTS_DIR");
+            Path dir = Path.of(d != null ? d : System.getProperty("java.io.tmpdir"));
+            Files.writeString(dir.resolve("dialects-dump-" + TAG + ".jsonl"), line, StandardCharsets.UTF_8,
+                    StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+        } catch (Throwable ignored) {
+            // the probe never fails the run
+        }
+    }
+}
