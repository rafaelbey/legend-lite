+
+package com.legend.base;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+
+/**
+ * TEMPORARY (Rust port, phase 3 step 0 -- never committed; rust/tools/identity-hits-probe.patch): every statement a JDBC
+ * session sends, in order, one line per statement (its length and a hash of its text), so a run with the identity probe can be compared with a run of this
+ * class alone ({@code git apply --include='*JdbcStatements.java' --include='*SqlTap.java'}): counting must not alter what
+ * is computed. Written to the test's undeclared outputs, else java.io.tmpdir.
+ */
+public final class SqlTap {
+
+    private SqlTap() {
+    }
+
+    private static final String FILE = "identity-sql-" + ProcessHandle.current().pid() + ".txt";
+
+    public static String sent(String statement) {
+        write(statement.length() + ":" + id(statement) + "\n");
+        return statement;
+    }
+
+    private static String id(String text) {
+        try {
+            return java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(text.getBytes(StandardCharsets.UTF_8)), 0, 12);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static synchronized void write(String line) {
+        try {
+            String d = System.getenv("TEST_UNDECLARED_OUTPUTS_DIR");
+            Path dir = Path.of(d != null ? d : System.getProperty("java.io.tmpdir"));
+            Files.writeString(dir.resolve(FILE), line, StandardCharsets.UTF_8, StandardOpenOption.CREATE,
+                    StandardOpenOption.APPEND);
+        } catch (IOException | RuntimeException e) {
+            // a probe that cannot write must not fail the test it rides on
+        }
+    }
+}
