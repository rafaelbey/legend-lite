diff --git a/base/src/main/java/com/legend/base/IdentityProbe.java b/base/src/main/java/com/legend/base/IdentityProbe.java
new file mode 100644
--- /dev/null
+++ b/base/src/main/java/com/legend/base/IdentityProbe.java
@@ -0,0 +1,458 @@
+// Copyright 2026 Legend Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package com.legend.base;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * TEMPORARY (Rust port, phase 3 step 0 -- never committed; rust/tools/identity-hits-probe.patch, docs/rust-port/PHASE3.md):
+ * counts, per question, the hits and misses of the identity tables and the outcomes of the identity comparisons that
+ * docs/rust-port/PHASE3_DESIGN.md section 1.1 lists, so that the Rust port can be held to them after the Java is gone. The
+ * patch being applied is the switch. It only observes: every entry point returns its argument, or the value the caller
+ * computed.
+ *
+ * <p>A SCOPE is one row: 'B' the boot layer (once per JVM), 'M' a model compile, 'Q' a query (one TypedQuery or one of
+ * Compiler's own typed passes). The running thread's current scope receives every count. Query ids: {@code t:<sha>} the
+ * query's text, {@code test:}/{@code fixture:}/{@code service:} the runner's name for it, else {@code vs:<sha>} of the
+ * resolved spec's toString. Model ids: {@code t:<sha>} a model text, {@code s:<sha>} the source list parseSources saw,
+ * {@code p:<sha>} the parsed records, {@code protocol:<sha>} a client's PureModelContextData. A text's sha is SHA-256 of its
+ * UTF-16 units, little-endian: rust/oracles/front's id.
+ *
+ * <p>A table named {@code model.*} is a model-tier table. Fired inside a query it is order-dependent on a shared context
+ * (the first query to touch a class pays for it), so it joins the query's row only when that context served exactly one
+ * query, and otherwise a row 'L' of the context, keyed by the hash of the queries that ran on it.
+ *
+ * <p>Written at JVM exit to the test's undeclared outputs, else java.io.tmpdir (a java_run action's declared scratch
+ * directory): {@code identity-hits-<pid>.tsv} and, for {@link #mir}, {@code identity-mir-<pid>.jsonl}.
+ */
+public final class IdentityProbe {
+
+    private IdentityProbe() {
+    }
+
+    public static final class Scope {
+        final char kind;
+        final String model;
+        final String query;
+        final @Nullable Use use;
+        final LinkedHashMap<String, Integer> doors = new LinkedHashMap<>();
+        final HashMap<String, long[]> counts = new HashMap<>(32);
+        final HashMap<String, long[]> lazy = new HashMap<>(8);
+        final ArrayList<String> mir = new ArrayList<>(2);
+
+        Scope(char kind, String model, String query, @Nullable Use use) {
+            this.kind = kind;
+            this.model = model;
+            this.query = query;
+            this.use = use;
+        }
+    }
+
+    /** A compiled model's use: its id and the query scopes that ran on it. */
+    private static final class Use {
+        final String model;
+        final List<Scope> scopes = Collections.synchronizedList(new ArrayList<>());
+
+        Use(String model) {
+            this.model = model;
+        }
+    }
+
+    private static final String PID = String.valueOf(ProcessHandle.current().pid());
+    private static final List<Scope> SCOPES = Collections.synchronizedList(new ArrayList<>());
+    private static final List<Use> ALL_USES = Collections.synchronizedList(new ArrayList<>());
+    private static final ThreadLocal<@Nullable Scope> CURRENT = new ThreadLocal<>();
+    private static final ThreadLocal<@Nullable String> LABEL = new ThreadLocal<>();
+    private static final ThreadLocal<@Nullable List<String>> SOURCES = new ThreadLocal<>();
+    private static final Map<Object, Use> USES = Collections.synchronizedMap(new WeakHashMap<>());
+    private static final Scope BOOT = register(new Scope('B', "boot", "-", null));
+    private static final Scope UNSCOPED = new Scope('U', "-", "-", null);
+    private static final Set<String> MIR_SEEN = ConcurrentHashMap.newKeySet();
+    private static final java.util.concurrent.atomic.AtomicLong UNKNOWN_CONTEXTS =
+            new java.util.concurrent.atomic.AtomicLong();
+
+    static {
+        Runtime.getRuntime().addShutdownHook(new Thread(IdentityProbe::dump, "identity-probe"));
+    }
+
+    private static Scope register(Scope s) {
+        SCOPES.add(s);
+        return s;
+    }
+
+    // ---- counts: each returns what the caller computed
+
+    /** A map's {@code get}: a hit when it found a value. */
+    public static <V> @Nullable V got(String table, @Nullable V value) {
+        bump(table, value != null);
+        return value;
+    }
+
+    /** A {@code contains}/{@code containsKey}, or any lookup whose answer is a boolean. */
+    public static boolean has(String table, boolean found) {
+        bump(table, found);
+        return found;
+    }
+
+    /** A set's {@code add}: a hit when the element was already there (the add answered false). */
+    public static boolean added(String table, boolean isNew) {
+        bump(table, !isNew);
+        return isNew;
+    }
+
+    /** {@code n} lookups known to hit (a sort's keys, whose comparator count is the JDK's, not the program's). */
+    public static void hits(String table, int n) {
+        for (int i = 0; i < n; i++) {
+            bump(table, true);
+        }
+    }
+
+    /** A reference comparison's outcome. */
+    public static boolean same(String site, boolean outcome) {
+        bump(site, outcome);
+        return outcome;
+    }
+
+    private static void bump(String table, boolean positive) {
+        Scope s = CURRENT.get();
+        if (s == null) {
+            synchronized (UNSCOPED) {
+                inc(UNSCOPED.counts, table, positive);
+            }
+            return;
+        }
+        inc(s.kind == 'Q' && table.startsWith("model.") ? s.lazy : s.counts, table, positive);
+    }
+
+    private static void inc(Map<String, long[]> into, String table, boolean positive) {
+        long[] c = into.get(table);
+        if (c == null) {
+            c = new long[2];
+            into.put(table, c);
+        }
+        c[positive ? 0 : 1]++;
+    }
+
+    // ---- scopes
+
+    public static final class Door implements AutoCloseable {
+        private final boolean active;
+        private final @Nullable Scope previous;
+
+        Door(boolean active, @Nullable Scope previous) {
+            this.active = active;
+            this.previous = previous;
+        }
+
+        @Override
+        public void close() {
+            if (active) {
+                if (previous == null) {
+                    CURRENT.remove();
+                } else {
+                    CURRENT.set(previous);
+                }
+            }
+        }
+    }
+
+    private static final Door NO_DOOR = new Door(false, null);
+
+    /** A question's scope, or null when this thread is already inside one (its counts stay there) or the context was
+     *  not compiled through a door the probe sees. */
+    public static @Nullable Scope queryScope(Object ctx, @Nullable Object resolved, @Nullable String text) {
+        Scope cur = CURRENT.get();
+        if (cur != null && cur.kind == 'Q') {
+            return null;
+        }
+        Use use = USES.get(ctx);
+        if (use == null) {
+            UNKNOWN_CONTEXTS.incrementAndGet();
+            return null;
+        }
+        String label = LABEL.get();
+        String query = text != null ? textId(text) : label != null ? label : specId(resolved);
+        Scope s = register(new Scope('Q', use.model, query, use));
+        use.scopes.add(s);
+        return s;
+    }
+
+    /** Enter a question's scope under a door of the given name. */
+    public static Door door(@Nullable Scope scope, String name) {
+        Scope cur = CURRENT.get();
+        if (scope == null || cur == scope || (cur != null && cur.kind == 'Q')) {
+            return NO_DOOR;
+        }
+        scope.doors.merge(name, 1, Integer::sum);
+        CURRENT.set(scope);
+        return new Door(true, cur);
+    }
+
+    /** Enter a model compile's scope; a nested door joins the open one. */
+    public static Door modelDoor(String model, String name) {
+        Scope cur = CURRENT.get();
+        if (cur != null && cur.kind == 'M') {
+            return NO_DOOR;
+        }
+        Scope s = register(new Scope('M', model, "-", null));
+        s.doors.merge(name, 1, Integer::sum);
+        CURRENT.set(s);
+        return new Door(true, cur);
+    }
+
+    /** The boot layer's scope, so that its one computation in a JVM is its own row, whichever test pays for it. */
+    public static Door bootDoor() {
+        Scope cur = CURRENT.get();
+        CURRENT.set(BOOT);
+        return new Door(true, cur);
+    }
+
+    /** The sticky name of the question a runner is about to ask (a test, a fixture, a service test). */
+    public static AutoCloseable0 label(String name) {
+        String before = LABEL.get();
+        LABEL.set(name);
+        return () -> {
+            if (before == null) {
+                LABEL.remove();
+            } else {
+                LABEL.set(before);
+            }
+        };
+    }
+
+    public interface AutoCloseable0 extends AutoCloseable {
+        @Override
+        void close();
+    }
+
+    public static <C> C compiled(C ctx, String model) {
+        Use use = new Use(model);
+        ALL_USES.add(use);
+        USES.put(ctx, use);
+        return ctx;
+    }
+
+    /** An overlay of a compiled model (a corpus's runtime and connection): a model of its own. */
+    public static <C> C overlay(Object parent, C child, String suffix) {
+        Use p = USES.get(parent);
+        return compiled(child, (p == null ? "?" : p.model) + "+" + suffix);
+    }
+
+    // ---- model ids
+
+    public static void sourcesSeen(String name, String text) {
+        List<String> l = SOURCES.get();
+        if (l == null) {
+            l = new ArrayList<>();
+            SOURCES.set(l);
+        }
+        l.add(name);
+        l.add(text);
+    }
+
+    /** The open model door's id, else the id of the sources this thread parsed since the last build, else of the
+     *  records. */
+    public static String modelId(Object parsed) {
+        Scope cur = CURRENT.get();
+        if (cur != null && cur.kind == 'M') {
+            return cur.model;
+        }
+        List<String> l = SOURCES.get();
+        if (l != null) {
+            SOURCES.remove();
+            return "s:" + sha(String.join("\u0000", l));
+        }
+        return "p:" + sha(String.valueOf(parsed));
+    }
+
+    public static String textId(String text) {
+        return "t:" + sha(text);
+    }
+
+    public static String protocolId(Object model) {
+        return "protocol:" + sha(String.valueOf(model));
+    }
+
+    private static String specId(@Nullable Object resolved) {
+        try {
+            return "vs:" + sha(String.valueOf(resolved));
+        } catch (StackOverflowError e) {
+            return "vs:too-deep";
+        }
+    }
+
+    private static String sha(String text) {
+        MessageDigest d;
+        try {
+            d = MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+        byte[] b = new byte[text.length() * 2];
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            b[2 * i] = (byte) c;
+            b[2 * i + 1] = (byte) (c >> 8);
+        }
+        return HexFormat.of().formatHex(d.digest(b));
+    }
+
+    // ---- the lowering's answer, as MirJson
+
+    /** A lowered query (or DML), for "the corpora through a Rust CLI": its MirJson's id in the scope's row, its text in
+     *  the JSONL. By reflection: base reaches neither sql nor executionplan. */
+    public static void mir(Object loweredQuery) {
+        mirOf(loweredQuery, "query", "com.legend.sql.SqlQuery");
+    }
+
+    public static void mirDml(Object dml) {
+        mirOf(dml, "dml", "com.legend.sql.SqlDml");
+    }
+
+    private static void mirOf(Object value, String writer, String type) {
+        Scope s = CURRENT.get();
+        if (s == null) {
+            return;
+        }
+        String text;
+        try {
+            Class<?> mir = Class.forName("com.legend.executionplan.MirJson");
+            Class<?> json = Class.forName("com.legend.json.Json");
+            Method w = mir.getMethod(writer, Class.forName(type));
+            text = (String) json.getMethod("toCompact", Object.class).invoke(null, w.invoke(null, value));
+        } catch (ReflectiveOperationException | LinkageError | RuntimeException e) {
+            Throwable c = e.getCause() != null ? e.getCause() : e;
+            String said = String.valueOf(c.getMessage()).replaceAll("[,\\t\\n]", " ");
+            s.mir.add("!" + c.getClass().getSimpleName() + ":" + said.substring(0, Math.min(60, said.length())));
+            return;
+        } catch (StackOverflowError e) {
+            s.mir.add("!StackOverflowError");
+            return;
+        }
+        String id = sha(text);
+        s.mir.add(id);
+        if (MIR_SEEN.add(id)) {
+            append("identity-mir-" + PID + ".jsonl", "{\"sha\":\"" + id + "\",\"mir\":" + text + "}\n");
+        }
+    }
+
+    // ---- the output
+
+    private static void dump() {
+        StringBuilder out = new StringBuilder();
+        List<Scope> scopes;
+        synchronized (SCOPES) {
+            scopes = new ArrayList<>(SCOPES);
+        }
+        for (Scope s : scopes) {
+            boolean solo = s.use != null && s.use.scopes.size() == 1;
+            Map<String, long[]> counts = new TreeMap<>(s.counts);
+            if (solo) {
+                counts.putAll(s.lazy);
+            }
+            if (s.kind == 'Q' && s.doors.isEmpty() && counts.isEmpty()) {
+                continue;
+            }
+            if (s.kind != 'Q' && counts.isEmpty()) {
+                continue;
+            }
+            line(out, s.kind, s.model, s.query, doors(s), s.kind == 'Q' ? (solo ? "solo" : "shared") : "-", counts, s.mir);
+        }
+        List<Use> uses;
+        synchronized (ALL_USES) {
+            uses = new ArrayList<>(ALL_USES);
+        }
+        for (Use u : uses) {
+            if (u.scopes.size() < 2) {
+                continue;
+            }
+            Map<String, long[]> lazy = new TreeMap<>();
+            List<String> queries = new ArrayList<>();
+            synchronized (u.scopes) {
+                for (Scope s : u.scopes) {
+                    queries.add(s.query + "\u0000" + doors(s));
+                    s.lazy.forEach((k, v) -> {
+                        long[] c = lazy.computeIfAbsent(k, x -> new long[2]);
+                        c[0] += v[0];
+                        c[1] += v[1];
+                    });
+                }
+            }
+            if (lazy.isEmpty()) {
+                continue;
+            }
+            Collections.sort(queries);
+            line(out, 'L', u.model, "set:" + sha(String.join("\u0001", queries)), "-", "shared", lazy, List.of());
+        }
+        Map<String, long[]> unscoped;
+        synchronized (UNSCOPED) {
+            unscoped = new TreeMap<>(UNSCOPED.counts);
+        }
+        if (!unscoped.isEmpty() || UNKNOWN_CONTEXTS.get() != 0) {
+            unscoped.put("unknown-contexts", new long[] {UNKNOWN_CONTEXTS.get(), 0});
+            line(out, 'U', "-", "-", "-", "-", unscoped, List.of());
+        }
+        if (out.length() > 0) {
+            append("identity-hits-" + PID + ".tsv", out.toString());
+        }
+    }
+
+    private static String doors(Scope s) {
+        StringBuilder b = new StringBuilder();
+        s.doors.forEach((k, v) -> {
+            if (b.length() > 0) {
+                b.append(',');
+            }
+            b.append(k);
+            if (v > 1) {
+                b.append('*').append(v);
+            }
+        });
+        return b.length() == 0 ? "-" : b.toString();
+    }
+
+    private static void line(StringBuilder out, char kind, String model, String query, String doors, String use,
+            Map<String, long[]> counts, List<String> mir) {
+        out.append(kind).append('\t').append(model).append('\t').append(query).append('\t').append(doors).append('\t')
+                .append(use).append('\t');
+        boolean first = true;
+        for (Map.Entry<String, long[]> e : counts.entrySet()) {
+            if (!first) {
+                out.append(';');
+            }
+            first = false;
+            out.append(e.getKey()).append('=').append(e.getValue()[0]).append('/').append(e.getValue()[1]);
+        }
+        out.append('\t').append(String.join(",", mir)).append('\n');
+    }
+
+    private static synchronized void append(String file, String text) {
+        try {
+            String d = System.getenv("TEST_UNDECLARED_OUTPUTS_DIR");
+            Path dir = Path.of(d != null ? d : System.getProperty("java.io.tmpdir"));
+            Files.writeString(dir.resolve(file), text, StandardCharsets.UTF_8, StandardOpenOption.CREATE,
+                    StandardOpenOption.APPEND);
+        } catch (IOException | RuntimeException e) {
+            // a probe that cannot write must not fail the test it rides on
+        }
+    }
+}
