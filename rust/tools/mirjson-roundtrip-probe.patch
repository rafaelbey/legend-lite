diff --git a/core/src/main/java/com/legend/sql/dialect/MirRoundTripProbe.java b/core/src/main/java/com/legend/sql/dialect/MirRoundTripProbe.java
new file mode 100644
index 000000000..a790ccca5
--- /dev/null
+++ b/core/src/main/java/com/legend/sql/dialect/MirRoundTripProbe.java
@@ -0,0 +1,171 @@
+// Copyright 2026 Legend Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package com.legend.sql.dialect;
+
+import com.legend.sql.SqlQuery;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Function;
+
+/**
+ * TEMPORARY (Rust port, phase 0 step 4 -- never committed): with LEGEND_MIRJSON_ROUNDTRIP set, every query a dialect
+ * renders is also rendered after a hop through its plan JSON (MirJson.query, Json.toCompact, Json.parse,
+ * MirJson.readQuery), and the two answers are compared. Reflection, because sql/dialect may not depend on
+ * executionplan or json. Mismatches and errors go to the test's undeclared outputs.
+ */
+final class MirRoundTripProbe {
+
+    private MirRoundTripProbe() {
+    }
+
+    static final boolean ON = System.getenv("LEGEND_MIRJSON_ROUNDTRIP") != null;
+    private static final ThreadLocal<Boolean> BUSY = ThreadLocal.withInitial(() -> Boolean.FALSE);
+    private static final AtomicLong OK = new AtomicLong();
+    private static final AtomicLong MISMATCH = new AtomicLong();
+    private static final AtomicLong ERROR = new AtomicLong();
+    private static final AtomicLong STMT_OK = new AtomicLong();
+    private static final AtomicLong STMT_MISMATCH = new AtomicLong();
+    private static final AtomicLong STMT_ERROR = new AtomicLong();
+    private static final AtomicLong LOGGED = new AtomicLong();
+    private static final long MAX_LOGGED = 500;
+    private static final Path DIR = dir();
+    private static final String TAG = String.valueOf(ProcessHandle.current().pid());
+
+    static {
+        if (ON) {
+            Runtime.getRuntime().addShutdownHook(new Thread(() -> append("mirjson-roundtrip-summary-" + TAG + ".txt",
+                    "ok\t" + OK.get() + "\nmismatch\t" + MISMATCH.get() + "\nerror\t" + ERROR.get()
+                            + "\nstmt_ok\t" + STMT_OK.get() + "\nstmt_mismatch\t" + STMT_MISMATCH.get()
+                            + "\nstmt_error\t" + STMT_ERROR.get() + "\n")));
+        }
+    }
+
+    private static Path dir() {
+        String d = System.getenv("TEST_UNDECLARED_OUTPUTS_DIR");
+        return Path.of(d != null ? d : System.getProperty("java.io.tmpdir"));
+    }
+
+    static <T> void check(AnsiSqlRenderer dialect, SqlQuery query, T original, Function<SqlQuery, T> again) {
+        if (!ON || BUSY.get()) {
+            return;
+        }
+        BUSY.set(Boolean.TRUE);
+        try {
+            SqlQuery back = roundTrip(query);
+            T second = again.apply(back);
+            if (second.equals(original)) {
+                OK.incrementAndGet();
+            } else {
+                MISMATCH.incrementAndGet();
+                T direct = again.apply(query);
+                String a = query.toString();
+                String b = back.toString();
+                int i = 0;
+                while (i < Math.min(a.length(), b.length()) && a.charAt(i) == b.charAt(i)) {
+                    i++;
+                }
+                int from = Math.max(0, i - 150);
+                log("MISMATCH", dialect, String.valueOf(original), String.valueOf(second)
+                        + "\tdirect-rerender-same=" + direct.equals(original)
+                        + "\ttree-equal=" + query.equals(back)
+                        + "\ttree-diverges-at=" + i
+                        + "\tq=" + a.substring(from, Math.min(a.length(), i + 250))
+                        + "\tback=" + b.substring(from, Math.min(b.length(), i + 250)));
+            }
+        } catch (Throwable t) {
+            ERROR.incrementAndGet();
+            log("ERROR", dialect, String.valueOf(original), t.getClass().getName() + ": " + t.getMessage());
+        } finally {
+            BUSY.set(Boolean.FALSE);
+        }
+    }
+
+    static void checkDdl(AnsiSqlRenderer dialect, com.legend.sql.SqlDdl d) {
+        statement(dialect, d, "ddl", "readDdl", com.legend.sql.SqlDdl.class,
+                x -> dialect.render((com.legend.sql.SqlDdl) x));
+    }
+
+    static void checkDml(AnsiSqlRenderer dialect, com.legend.sql.SqlDml d) {
+        statement(dialect, d, "dml", "readDml", com.legend.sql.SqlDml.class,
+                x -> outcome(() -> dialect.render((com.legend.sql.SqlDml) x)) + " | "
+                        + outcome(() -> String.valueOf(dialect.renderStatement((com.legend.sql.SqlDml) x))));
+    }
+
+    private static String outcome(java.util.function.Supplier<String> s) {
+        try {
+            return "OK:" + s.get();
+        } catch (RuntimeException e) {
+            return "THROWS:" + e.getClass().getName() + ": " + e.getMessage();
+        }
+    }
+
+    private static void statement(AnsiSqlRenderer dialect, Object d, String writer, String reader, Class<?> type,
+            Function<Object, String> render) {
+        if (!ON || BUSY.get()) {
+            return;
+        }
+        BUSY.set(Boolean.TRUE);
+        try {
+            Class<?> mir = Class.forName("com.legend.executionplan.MirJson");
+            Class<?> json = Class.forName("com.legend.json.Json");
+            Class<?> obj = Class.forName("com.legend.json.Json$Obj");
+            String text = (String) json.getMethod("toCompact", Object.class)
+                    .invoke(null, mir.getMethod(writer, type).invoke(null, d));
+            Object back = mir.getMethod(reader, obj).invoke(null, json.getMethod("parse", String.class).invoke(null, text));
+            String a = outcome(() -> render.apply(d));
+            String b = outcome(() -> render.apply(back));
+            if (a.equals(b) && d.equals(back)) {
+                STMT_OK.incrementAndGet();
+            } else {
+                STMT_MISMATCH.incrementAndGet();
+                log("STMT-MISMATCH", dialect, a, b + "\tstatement-equal=" + d.equals(back));
+            }
+        } catch (Throwable t) {
+            STMT_ERROR.incrementAndGet();
+            log("STMT-ERROR", dialect, String.valueOf(d), t.getClass().getName() + ": " + t.getMessage());
+        } finally {
+            BUSY.set(Boolean.FALSE);
+        }
+    }
+
+    private static SqlQuery roundTrip(SqlQuery q) throws ReflectiveOperationException {
+        Class<?> mir = Class.forName("com.legend.executionplan.MirJson");
+        Class<?> json = Class.forName("com.legend.json.Json");
+        Class<?> config = Class.forName("com.legend.json.Json$Config");
+        Class<?> obj = Class.forName("com.legend.json.Json$Obj");
+        Method query = mir.getMethod("query", SqlQuery.class);
+        Method toCompact = json.getMethod("toCompact", Object.class);
+        Method parse = json.getMethod("parse", String.class, config);
+        Method readQuery = mir.getMethod("readQuery", obj);
+        String text = (String) toCompact.invoke(null, query.invoke(null, q));
+        Object node = parse.invoke(null, text, config.getConstructor(int.class).newInstance(4096));
+        return (SqlQuery) readQuery.invoke(null, node);
+    }
+
+    private static void log(String kind, AnsiSqlRenderer dialect, String original, String other) {
+        if (LOGGED.incrementAndGet() > MAX_LOGGED) {
+            return;
+        }
+        append("mirjson-roundtrip-" + TAG + ".tsv", kind + "\t" + dialect.getClass().getSimpleName() + "\t"
+                + escape(original) + "\t" + escape(other) + "\n");
+    }
+
+    private static String escape(String s) {
+        return s.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n");
+    }
+
+    private static synchronized void append(String file, String line) {
+        try {
+            Files.writeString(DIR.resolve(file), line, StandardCharsets.UTF_8, StandardOpenOption.CREATE,
+                    StandardOpenOption.APPEND);
+        } catch (IOException e) {
+            // a probe that cannot write must not fail the test it rides on
+        }
+    }
+}
