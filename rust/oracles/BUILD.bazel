load("//tools/guards:defs.bzl", "guards_package")
load(":zstd.bzl", "zstd_decompress")

# The JVM's answers the Rust port is held to (rust/README.md): frozen data, read by the crates' tests.
exports_files(
    [
        "java-compat/double-tostring.tsv",
        # Java's Character predicates over every code point (JavaCompatExtras.java): lite-javacompat's character
        # module is held to it
        "java-compat/extras/char-classes.tsv",
        # the engine-text query holding a tagged value, as the shim sends it (mir/MANIFEST.tsv): the dialects'
        # differential reads it
        "mir/tagged-engine.jsonl",
        # the records the parser's doors can return (front/MANIFEST.tsv): what the front end's codec covers
        "front/schema.json",
        # the type family's answers (types/MANIFEST.tsv; 2026-11-11, phase 3 slice 1a): lite-types' differential reads
        # them
        "types/type-facts.tsv",
        # the platform's tables as Java holds them (builtin/MANIFEST.tsv; 2026-11-12, phase 3 slice 1b): lite-builtin's
        # and lite-platform's table tests read them
        "builtin/builtin-tables.tsv",
        "builtin/platform-tables.tsv",
    ],
    visibility = ["//rust:__subpackages__"],
)

# The front oracle's deliberate differences (its header says; rulings 4, 11 and 13 of docs/rust-port/PHASE2.md section
# 6): read by the three front differentials and by //core:front_shim.
exports_files(
    [
        "front/deliberate-differences.tsv",
    ],
    visibility = [
        "//core:__pkg__",
        "//rust:__subpackages__",
    ],
)

# Every statement the SQL-rendering suites render, as its MirJson and Java's answer on a fresh dialect
# (docs/rust-port/PHASE1.md §4; mir/MANIFEST.tsv): the MIR's round trip and the dialects' differential read it.
zstd_decompress(
    name = "mir_dump",
    testonly = True,
    src = "mir/mir-dump.jsonl.zst",
    out = "mir/mir-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The H2 family's renders and engine-text entry points over the whole suite, the corpus lanes included (phase 1 step 4;
# mir/MANIFEST.tsv): the MIR's round trip and the dialects' differential (H2, H2Modern and the engine-style ones) read
# it.
zstd_decompress(
    name = "h2_dump",
    testonly = True,
    src = "mir/h2-dump.jsonl.zst",
    out = "mir/h2-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The ten Java dialects left after the H2 family's switch (Postgres, SQLite, the cloud ones, MariaDB/MySQL, MongoDB):
# their renders over the whole suite (phase 1 step 5; mir/MANIFEST.tsv), for the MIR's round trip and their differentials.
zstd_decompress(
    name = "dialects_dump",
    testonly = True,
    src = "mir/dialects-dump.jsonl.zst",
    out = "mir/dialects-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The SQLite arms the dumps hold none of, rendered by Java's own SQLite (phase 1 step 5d; mir/SqliteArms.java,
# mir/MANIFEST.tsv): for the MIR's round trip and SQLite's differential.
zstd_decompress(
    name = "sqlite_arms",
    testonly = True,
    src = "mir/sqlite-arms.jsonl.zst",
    out = "mir/sqlite-arms.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The eight Java dialects left to port (Snowflake, BigQuery, Databricks, Trino, ClickHouse, MariaDb, MySql, MongoDb)
# over inputs that reach every arm each decides, rendered by Java's own dialects (phase 1 step 6a;
# mir/DialectArms.java, mir/MANIFEST.tsv): for the MIR's round trip and their differentials.
zstd_decompress(
    name = "dialect_arms",
    testonly = True,
    src = "mir/dialect-arms.jsonl.zst",
    out = "mir/dialect-arms.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The arms main added after the port's base (LIST_AT, a raw grid's report, a CSV file's load, H2's folded navigation, one
# alias in two query blocks), over inputs no frozen dump holds, rendered by main's own dialects at c4a39e06d (the merge
# of main, 2026-11-10; mir/MergeArms.java, mir/MANIFEST.tsv): for the MIR's round trip and every dialect's differential.
zstd_decompress(
    name = "merge_arms",
    testonly = True,
    src = "mir/merge-arms.jsonl.zst",
    out = "mir/merge-arms.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# Every question the test suite asks the parser's text doors, and every model text at all three dialects (phase 2
# step 1; front/MANIFEST.tsv): the front end's differentials ask Java and Rust each one.
zstd_decompress(
    name = "front_questions",
    testonly = True,
    src = "front/questions.jsonl.zst",
    out = "front/questions.jsonl",
    visibility = [
        "//core:__pkg__",
        "//rust:__subpackages__",
    ],
)

# Java's answers to those questions, frozen before the Java lexer and parser are deleted (phase 2 step 6a;
# front/MANIFEST.tsv): each line one question's hashes, in the questions file's order. The front end's three
# differentials read them: the lexer's token streams, the four parser doors' answers, the engine-JSON doors' two forms.
zstd_decompress(
    name = "front_tokens",
    testonly = True,
    src = "front/tokens.tsv.zst",
    out = "front/tokens.tsv",
    visibility = ["//rust:__subpackages__"],
)

zstd_decompress(
    name = "front_answers",
    testonly = True,
    src = "front/answers.tsv.zst",
    out = "front/answers.tsv",
    # and //core:front_shim, the switched doors end to end against them (2026-11-06, step 6b)
    visibility = [
        "//core:__pkg__",
        "//rust:__subpackages__",
    ],
)

zstd_decompress(
    name = "front_engine",
    testonly = True,
    src = "front/engine.tsv.zst",
    out = "front/engine.tsv",
    visibility = [
        "//core:__pkg__",
        "//rust:__subpackages__",
    ],
)

# Java's door's answer to every model text of the front oracle, at every dialect asked (2026-11-12, phase 3 slice 1b;
# model/MANIFEST.tsv): the canonical text's SHA-256 per ask, frozen before the Java goes; the model differential
# (//rust/lite-builtin:model_differential_test) reads it.
zstd_decompress(
    name = "model_answers",
    testonly = True,
    src = "model/answers.tsv.zst",
    out = "model/answers.tsv",
    visibility = ["//rust:__subpackages__"],
)

# What step D hands on, as the live Java answered it (2026-11-12, phase 3's names slice; names/MANIFEST.tsv): the
# canonical text's SHA-256 per model ask and per (query, model) pair, frozen before the Java goes; the names
# differential (//rust/lite-names:names_differential_test) reads them.
zstd_decompress(
    name = "names_models",
    testonly = True,
    src = "names/models.tsv.zst",
    out = "names/models.tsv",
    visibility = ["//rust:__subpackages__"],
)

zstd_decompress(
    name = "names_queries",
    testonly = True,
    src = "names/queries.tsv.zst",
    out = "names/queries.tsv",
    visibility = ["//rust:__subpackages__"],
)

guards_package()
