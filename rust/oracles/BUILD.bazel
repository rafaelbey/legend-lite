load("//tools/guards:defs.bzl", "guards_package")
load(":zstd.bzl", "zstd_decompress")

# The JVM's answers the Rust port is held to (rust/README.md): frozen data, read by the crates' tests.
exports_files(
    [
        "java-compat/double-tostring.tsv",
        # Java's Character predicates over every code point (JavaCompatExtras.java): lite-javacompat's character
        # module is held to it
        "java-compat/extras/char-classes.tsv",
        # the engine-text query holding a tagged value, as the shim sends it (mir/MANIFEST.tsv): the dialects'
        # differential reads it
        "mir/tagged-engine.jsonl",
    ],
    visibility = ["//rust:__subpackages__"],
)

# Every statement the SQL-rendering suites render, as its MirJson and Java's answer on a fresh dialect
# (docs/rust-port/PHASE1.md §4; mir/MANIFEST.tsv): the MIR's round trip and the dialects' differential read it.
zstd_decompress(
    name = "mir_dump",
    testonly = True,
    src = "mir/mir-dump.jsonl.zst",
    out = "mir/mir-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The H2 family's renders and engine-text entry points over the whole suite, the corpus lanes included (phase 1 step 4;
# mir/MANIFEST.tsv): the MIR's round trip and the dialects' differential (H2, H2Modern and the engine-style ones) read
# it.
zstd_decompress(
    name = "h2_dump",
    testonly = True,
    src = "mir/h2-dump.jsonl.zst",
    out = "mir/h2-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The ten Java dialects left after the H2 family's switch (Postgres, SQLite, the cloud ones, MariaDB/MySQL, MongoDB):
# their renders over the whole suite (phase 1 step 5; mir/MANIFEST.tsv), for the MIR's round trip and their differentials.
zstd_decompress(
    name = "dialects_dump",
    testonly = True,
    src = "mir/dialects-dump.jsonl.zst",
    out = "mir/dialects-dump.jsonl",
    visibility = ["//rust:__subpackages__"],
)

# The SQLite arms the dumps hold none of, rendered by Java's own SQLite (phase 1 step 5d; mir/SqliteArms.java,
# mir/MANIFEST.tsv): for the MIR's round trip and SQLite's differential.
zstd_decompress(
    name = "sqlite_arms",
    testonly = True,
    src = "mir/sqlite-arms.jsonl.zst",
    out = "mir/sqlite-arms.jsonl",
    visibility = ["//rust:__subpackages__"],
)

guards_package()
