load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/guards:defs.bzl", "guards_package")

# legend-lite's element compiler, ported from core's com.legend.compiler.element (src/lib.rs; docs/rust-port/PHASE3.md,
# the element slice, 2026-11-15): step F, PureModelContext as the concrete Model; its skeleton first. The second part
# of the compiler's split (rust/lite-guards/crate-layers.txt: compiler/element), so it reaches no spec crate.
rust_library(
    name = "lite_element",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//rust:__subpackages__"],
    deps = [
        "//rust/lite-base:lite_base",
        "//rust/lite-builtin:lite_builtin",
        "//rust/lite-error:lite_error",
        "//rust/lite-front:lite_front",
        "//rust/lite-model:lite_model",
        "//rust/lite-names:lite_names",
        "//rust/lite-platform:lite_platform",
        "//rust/lite-types:lite_types",
    ],
)

rust_test(
    name = "lite_element_test",
    crate = ":lite_element",
    edition = "2024",
    visibility = ["//gates:__pkg__"],
)

# the crate's sources and manifest, for //rust/lite-guards' source and crate-graph guards (tests/ joins the glob with
# the differential, the slice's step 5: an include pattern that matches nothing is a glob error)
filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + ["Cargo.toml"],
    visibility = ["//rust/lite-guards:__pkg__"],
)

guards_package()
