load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/guards:defs.bzl", "guards_package")

# legend-lite's model normalizer, ported from core's com.legend.normalizer (src/lib.rs; docs/rust-port/PHASE3.md, the
# normalizer slice, 2026-11-14): step E, ParsedModel -> NormalizedModel, line for line.
rust_library(
    name = "lite_normalizer",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//rust:__subpackages__"],
    deps = [
        "//rust/lite-base:lite_base",
        "//rust/lite-builtin:lite_builtin",
        "//rust/lite-error:lite_error",
        "//rust/lite-front:lite_front",
        "//rust/lite-model:lite_model",
        "//rust/lite-names:lite_names",
        "//rust/lite-platform:lite_platform",
        "//rust/lite-types:lite_types",
    ],
)

rust_test(
    name = "lite_normalizer_test",
    crate = ":lite_normalizer",
    edition = "2024",
    visibility = ["//gates:__pkg__"],
)

# The normalizer differential (tests/normalizer_differential.rs): every model text of the front oracle, then of the
# slice's cases, at every dialect asked, run D then E strict and tolerant (resolve_alongside, the association adoption,
# the index, refuse_duplicates, normalize), each canonical text held to the Java's (the SHA-256 per ask, frozen:
# //rust/oracles:normalizer_answers; rust/oracles/normalizer/MANIFEST.tsv) -- buckets equal, mismatch and unported (an
# ask that reaches a body not ported, counted per site). Every ask must be equal: 74,364 of 74,364 since the fill
# (2026-11-14, the normalizer slice, step 5). Large, and in //gates:core, as the names differential (ruling 28).
rust_test(
    name = "normalizer_differential_test",
    size = "large",
    srcs = ["tests/normalizer_differential.rs"],
    args = ["--ignored"],
    data = [
        "//rust/oracles:front_questions",
        "//rust/oracles:normalizer_answers",
        "//rust/oracles:normalizer_cases",
    ],
    edition = "2024",
    env = {
        "LITE_NORMALIZER_ANSWERS": "$(rootpath //rust/oracles:normalizer_answers)",
        "LITE_NORMALIZER_CASES": "$(rootpath //rust/oracles:normalizer_cases)",
        "LITE_NORMALIZER_QUESTIONS": "$(rootpath //rust/oracles:front_questions)",
    },
    visibility = ["//gates:__pkg__"],
    deps = [
        ":lite_normalizer",
        "//rust/lite-builtin:lite_builtin",
        "//rust/lite-front:lite_front",
        "//rust/lite-model:lite_model",
        "//rust/lite-names:lite_names",
    ],
)

# the crate's sources and manifest, for //rust/lite-guards' source and crate-graph guards
filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs", "tests/**/*.rs"]) + ["Cargo.toml"],
    visibility = ["//rust/lite-guards:__pkg__"],
)

guards_package()
